# LoRA training environment built on the validated baseline image.
FROM llm-post-training-lab:base

# Pin the established core stack and add LoRA dependencies.
#
# Explicit core-version requirements prevent pip from silently
# replacing PyTorch or Transformers with newer versions.
RUN python3 -m pip install --no-cache-dir \
        "torch==2.14.0+cu126" \
        "transformers==4.57.6" \
        "safetensors==0.8.0" \
        "peft==0.18.1" \
        "accelerate==1.12.0" \
    && python3 -m pip check
